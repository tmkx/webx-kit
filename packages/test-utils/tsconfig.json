{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "ESNext"],
    "allowJs": false,
    "module": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "jsx": "preserve",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": "./",
    "noEmit": true,
  },
  "exclude": ["dist"]
}
